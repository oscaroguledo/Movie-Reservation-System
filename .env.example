# Copy this file to .env and adjust as needed. .env is gitignored — never
# commit real secrets. These are the variables docker-compose.yml reads for
# variable substitution; each service also has its own defaults in
# core/config.py, so nothing here is strictly required for a quick local run.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=movie_reservation
# Host port only — 5432 is often already taken by a local Postgres install.
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PORT=6379

# --- Kafka ---
KAFKA_PORT=9092

# --- Shared ---
LOG_LEVEL=INFO
# Comma-separated origins allowed to call either API from a browser; "*"
# allows any and is fine for local dev, but should be locked down in prod.
CORS_ALLOWED_ORIGINS=*

# --- auth-api ---
AUTH_API_PORT=8000
# Must be identical in movie-api — movie-api verifies the JWTs auth-api
# issues, so both services need to agree on the signing key. Generate a
# real one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-32-byte-hex-string
JWT_DEFAULT_EXPIRATION_MINUTES=30

# Bootstraps the very first admin on auth-api startup, since every
# admin-management endpoint otherwise requires an existing admin. Leave both
# blank to skip seeding.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- movie-api ---
MOVIE_API_PORT=8001
# Seconds a held (not yet confirmed) seat reservation stays reserved before
# it's treated as expired.
HOLD_TTL_SECONDS=30
